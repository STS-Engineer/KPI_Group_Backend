PG_USER=
PG_HOST=
PG_PASSWORD=
PG_PORT=5432
PG_DATABASE_KPI=KPI_DB_Final
PG_DATABASE_ACTION_PLAN=Action Plan
SECRET_KEY=
# OpenAI model of the AI Assistant (chat button of every page)
# KPI_ASSISTANT_MODEL=gpt-4o-mini
PORT=5001
FRONTEND_URL=http://localhost:5173
SMTP_HOST=avocarbon-com.mail.protection.outlook.com
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
KPI_FORM_REQUIRE_CORRECTIVE_ACTION=false

# Local runs against the shared production database: keep the weekly e-mail crons off.
DISABLE_CRON_JOBS=true

# --- Authentication (defaults shown) ---
# FRONTEND_URL above is also the list of allowed origins (comma-separated) and the base of e-mail links.
# AUTH_APP_URL=                      # overrides the base URL of invitation / reset links
# AUTH_MAIL_FROM="KPI Manager" <kpi-manager@avocarbon.com>
# AUTH_COOKIE_SAMESITE=lax           # use "none" (with HTTPS) if frontend and backend are on different sites
# AUTH_COOKIE_SECURE=                # defaults to true when NODE_ENV=production
# AUTH_SESSION_TTL_HOURS=12
# AUTH_SESSION_IDLE_MINUTES=120
# AUTH_RESET_TOKEN_TTL_MINUTES=60
# AUTH_INVITE_TOKEN_TTL_HOURS=72
# AUTH_MAX_FAILED_LOGINS=5
# AUTH_LOCKOUT_MINUTES=15
# TRUST_PROXY=1                      # behind Azure App Service / a reverse proxy

# --- Sign in with Microsoft (Entra ID app registration "KPI Manager") ---
# All four are required, otherwise the "Continue with Microsoft" button is hidden.
# Never commit the secret: put it in .env (local) or the Azure environment variables.
# The app needs the delegated Microsoft Graph permissions openid, profile, email and
# offline_access (always requested by MSAL), with "Grant admin consent" -- otherwise
# Microsoft shows users "Approval required" / "Approbation requise".
# AZURE_REDIRECT_URI must be registered on the app (platform "Web"):
#   local:      http://localhost:5001/api/auth/microsoft/callback
#   kpi-codir:  https://kpi-codir.azurewebsites.net/api/auth/microsoft/callback
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:5001/api/auth/microsoft/callback
